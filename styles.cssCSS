/* Variables CSS - Paleta Elegante */
:root {
    --primary-color: #8a4b6e;
    --secondary-color: #b57295;
    --accent-color: #d1a1b8;
    --bg-light: #fbf8f9;
    --bg-white: #ffffff;
    --text-dark: #3a2e39;
    --text-muted: #6e5e6b;
    --text-light: #ffffff;
    --border-color: #f0e2e9;
    --font-main: 'Plus Jakarta Sans', sans-serif;
}
