body {
    font-family: Arial, sans-serif;
    line-height: 1.6;
    margin: 0;
    padding: 0;
    background-color: #f4f4f4;
    color: #333;
    transition: background-color 0.3s ease, color 0.3s ease;
}

header {
    background: #35424a;
    color: white;
    padding: 1rem;
    text-align: center;
}

nav ul {
    list-style: none;
    padding: 0;
}

nav ul li {
    display: inline;
    margin: 0 1rem;
}

nav a, nav button {
    color: white;
    text-decoration: none;
    background: none;
    border: none;
    font-size: 1rem;
    cursor: pointer;
}

section {
    padding: 1.5rem;
    max-width: 800px;
    margin: 0 auto;
}

form label, form input, form textarea, form button {
    display: block;
    width: 100%;
    margin: 0.5rem 0;
    padding: 0.5rem;
    box-sizing: border-box;
}

#boton-arriba {
    position: fixed;
    bottom: 2rem;
    right: 2rem;
    padding: 0.5rem 1rem;
    background: #35424a;
    color: white;
    border: none;
    border-radius: 5px;
    cursor: pointer;
}

.oculto { display: none; }

.modo-oscuro {
    background-color: #1a1a1a;
    color: #f0f0f0;
}

.modo-oscuro header { background: #222; }
.modo-oscuro #boton-arriba { background: #444; }
