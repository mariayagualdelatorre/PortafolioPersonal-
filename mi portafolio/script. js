function validarFormulario(evento) {
    evento.preventDefault();
    const nombre = document.getElementById('nombre').value.trim();
    const correo = document.getElementById('correo').value.trim();
    const mensaje = document.getElementById('mensaje').value.trim();

    localStorage.setItem('nombreGuardado', nombre);
    localStorage.setItem('correoGuardado', correo);
    localStorage.setItem('mensajeGuardado', mensaje);

    if (nombre === '' || correo === '' || mensaje === '') {
        mensajeConfirmacion.textContent = '❌ Error: Todos los campos son obligatorios.';
        mensajeConfirmacion.style.color = 'red';
    } else {
        mensajeConfirmacion.textContent = `✅ ¡Gracias ${nombre}! Tu mensaje ha sido enviado correctamente.`;
        mensajeConfirmacion.style.color = 'green';
        formulario.reset();
        localStorage.removeItem('nombreGuardado');
        localStorage.removeItem('correoGuardado');
        localStorage.removeItem('mensajeGuardado');
    }
}

function volverAlInicio() {
    window.scrollTo({ top: 0, behavior: 'smooth' });
}

function cargarDatosGuardados() {
    const modoGuardado = localStorage.getItem('preferenciaModo');
    if (modoGuardado === 'oscuro') {
        cuerpoPagina.classList.add('modo-oscuro');
        botonModo.textContent = '☀️ Modo Claro';
    }
    const nombreGuardado = localStorage.getItem('nombreGuardado');
    if (nombreGuardado && nombreGuardado !== '') {
        mensajeUsuario.textContent = `¡Bienvenido de nuevo, ${nombreGuardado}! 👋`;
    }
}

botonModo.addEventListener('click', alternarModoOscuro);
botonProyectos.addEventListener('click', alternarProyectos);

textoSobreMi.addEventListener('mouseover', function() {
    textoSobreMi.textContent = '¡Gracias por visitar mi portafolio! 🎉';
    textoSobreMi.style.color = '#2980b9';
});

textoSobreMi.addEventListener('mouseout', function() {
    textoSobreMi.textContent = 'Hola, soy un estudiante de desarrollo web. ¡Pasa el cursor aquí!';
    textoSobreMi.style.color = '';
});

formulario.addEventListener('submit', validarFormulario);
botonArriba.addEventListener('click', volverAlInicio);

window.addEventListener('load', function() {
    cargarDatosGuardados();
    mostrarFechaHora();
});
