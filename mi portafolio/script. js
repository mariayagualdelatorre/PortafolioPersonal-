const botonModo = document.getElementById('boton-modo');
const cuerpoPagina = document.body;
const textoSobreMi = document.getElementById('texto-sobre-mi');
const botonProyectos = document.getElementById('boton-proyectos');
const listaProyectos = document.getElementById('lista-proyectos');
const formulario = document.getElementById('formulario-contacto');
const mensajeConfirmacion = document.getElementById('mensaje-confirmacion');
const botonArriba = document.getElementById('boton-arriba');
const fechaHoraElemento = document.getElementById('fecha-hora');
const mensajeUsuario = document.getElementById('mensaje-usuario');

function alternarModoOscuro() {
    cuerpoPagina.classList.toggle('modo-oscuro');
    const modoActivo = cuerpoPagina.classList.contains('modo-oscuro') ? 'oscuro' : 'claro';
    localStorage.setItem('preferenciaModo', modoActivo);
    botonModo.textContent = modoActivo === 'oscuro' ? '☀️ Modo Claro' : '🌙 Modo Oscuro';
}

function alternarProyectos() {
    listaProyectos.classList.toggle('oculto');
    botonProyectos.textContent = listaProyectos.classList.contains('oculto') 
        ? 'Mostrar Proyectos' : 'Ocultar Proyectos';
}

